!.vscode/extensions.json
Thumbs.db
Desktop.ini

# Archivos generados o específicos del equipo Android
/android-app/.gradle/
/android-app/.idea/
/android-app/**/build/
/android-app/local.properties
/android-app/**/*.apk
/android-app/**/*.iml
